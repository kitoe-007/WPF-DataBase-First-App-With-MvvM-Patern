<Window x:Class="DataBaseFirstWpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DataBaseFirstWpfApp"
        mc:Ignorable="d"        
        xmlns:vm="clr-namespace:DataBaseFirstWpfApp.ViewModels"
        Title="Оптовый склад" Height="600" Width="900">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <WrapPanel Orientation="Horizontal">
            <ComboBox Width="120" ItemsSource="{Binding Tables}" SelectedItem="{Binding SelectedTable}"/>
            <Button Content="Добавить" Margin="5,0" Command="{Binding AddCommand}"/>
            <Button Content="Команда 1" Margin="10,0, 0, 0" Command="{Binding Command1Command}"/>
            <Button Content="Команда 2" Margin="5,0, 0, 0" Command="{Binding Command2Command}"/>
            <Button Content="Команда 3" Margin="5,0, 0, 0" Command="{Binding Command3Command}"/>
            <Button Content="Команда 4" Margin="5,0, 0, 0" Command="{Binding Command4Command}"/>
            <TextBlock Text="с" Margin="15,0,5,0" VerticalAlignment="Center"/>
            <DatePicker SelectedDate="{Binding DateFrom}"/>
            <TextBlock Text="по" Margin="5,0" VerticalAlignment="Center"/>
            <DatePicker SelectedDate="{Binding DateTo}"/>
            <Button Content="Команда 5" Margin="5,0, 0, 0" Command="{Binding Command5Command}"/>
            <TextBox TextWrapping="Wrap" Text="{Binding SelectType}" Width="120" Margin="5,0, 0, 0"/>
        </WrapPanel>

        <DataGrid Grid.Row="1" Margin="0,5" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
                  IsReadOnly="True" AutoGeneratingColumn="DataGrid_AutoGeneratingColumn">
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Изменить" Command="{Binding EditCommand}"/>
                    <MenuItem Header="Удалить" Command="{Binding DeleteCommand}"/>
                </ContextMenu>
            </DataGrid.ContextMenu>
        </DataGrid>
    </Grid>
</Window>
