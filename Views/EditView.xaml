<Window x:Class="DataBaseFirstWpfApp.Views.EditView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m="clr-namespace:DataBaseFirstWpfApp.Models"
        Title="Запись" SizeToContent="WidthAndHeight" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <DataTemplate DataType="{x:Type m:Product}">
            <StackPanel Width="250">
                <TextBlock Text="Наименование"/>
                <TextBox Text="{Binding Name}"/>
                <TextBlock Text="Тип"/>
                <TextBox Text="{Binding Type}"/>
                <TextBlock Text="Производитель"/>
                <TextBox Text="{Binding Manufacturer}"/>
                <TextBlock Text="Условия хранения"/>
                <TextBox Text="{Binding StorageConditions}"/>
                <TextBlock Text="Упаковка"/>
                <TextBox Text="{Binding Packaging}"/>
                <TextBlock Text="Срок годности (дней)"/>
                <TextBox Text="{Binding ShelfLife, TargetNullValue=''}"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type m:Supplier}">
            <StackPanel Width="250">
                <TextBlock Text="Наименование"/>
                <TextBox Text="{Binding Name}"/>
                <TextBlock Text="Адрес"/>
                <TextBox Text="{Binding Address}"/>
                <TextBlock Text="Телефон"/>
                <TextBox Text="{Binding Phone}"/>
                <TextBlock Text="Дата договора"/>
                <DatePicker SelectedDate="{Binding ContractDate}"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type m:Warehouse}">
            <StackPanel Width="250">
                <TextBlock Text="Дата поступления"/>
                <DatePicker SelectedDate="{Binding ReceiptDate}"/>
                <TextBlock Text="Товар"/>
                <ComboBox ItemsSource="{Binding DataContext.Products, RelativeSource={RelativeSource AncestorType=Window}}"
                          DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding ProductId}"/>
                <TextBlock Text="Поставщик"/>
                <ComboBox ItemsSource="{Binding DataContext.Suppliers, RelativeSource={RelativeSource AncestorType=Window}}"
                          DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding SupplierId}"/>
                <TextBlock Text="Способ доставки"/>
                <TextBox Text="{Binding DeliveryMethod}"/>
                <TextBlock Text="Объём"/>
                <TextBox Text="{Binding Volume}"/>
                <TextBlock Text="Цена"/>
                <TextBox Text="{Binding Price, TargetNullValue=''}"/>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <StackPanel Margin="10">
        <ContentControl Content="{Binding Item}"/>
        <Button Name="SaveButton" Margin="0,10,0,0" Click="Save_Click"/>
    </StackPanel>
</Window>
